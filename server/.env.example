# Copy to .env and adjust as needed.

PORT=4310

# Default bind. Set to 0.0.0.0 so other devices on your LAN can reach it
# (see Section 17 note in README if you want to lock this back down to
# localhost-only later).
HOST=0.0.0.0

# SQLite is the Stage 1 backend (portable, zero-config, matches the
# "single-user portable install" option in Section 10). The schema is
# written so that swapping in PostgreSQL later (Section 10.1) does not
# require changing the domain model.
DB_PATH=./data/tracker.db

# Reporting timezone used to render day/week boundaries (Section 8.2).
# Defaults to the server's local timezone if unset.
REPORTING_TZ=
